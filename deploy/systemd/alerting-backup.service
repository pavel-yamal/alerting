[Unit]
Description=Alerting — back up the database, audit spool and published heads
Documentation=file:///opt/alerting/current/docs/09-deployment.md
After=alerting.service

[Service]
Type=oneshot
User=alerting
Group=alerting
EnvironmentFile=/etc/alerting/alerting.env
Environment=ALERTING_BACKUP_DIR=/var/backups/alerting
ExecStart=/opt/alerting/current/deploy/backup/alerting-backup.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/alerting /var/lib/alerting
UMask=0077

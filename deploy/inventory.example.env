# Инвентарь контура. Копия этого файла — единственное место, где живут адреса.
#
# Так сделано не ради удобства. До него `10.0.10.11` был зашит в
# `alerting.service`, `10.0.10.0/24` — в nginx и в nftables, `10.0.20.7` — в
# nftables, и ещё несколько значений помечены `ADJUST` в разных файлах. Шесть
# файлов, которые обязаны согласоваться между собой, и ни одного места, где это
# согласование видно. Рассогласование при этом не падает: nginx стучится не туда,
# firewall режет не то, и узел выглядит здоровым.
#
#   cp deploy/inventory.example.env deploy/inventory.env   # и заполнить
#
# `inventory.env` в .gitignore: адреса боевого контура в репозитории не хранятся.
# Секретов здесь нет и быть не должно — пароли и ключи едут через
# `LoadCredential=`, см. deploy/env/credentials.README.md.

# --- узлы ---------------------------------------------------------------------
# Адреса, по которым узлы видят друг друга. Не публичные имена: наружу смотрит
# только прокси.
ALERTING_PROXY_ADDR=10.0.10.10
ALERTING_APP1_ADDR=10.0.10.11
ALERTING_APP2_ADDR=10.0.10.12
ALERTING_DB_PRIMARY_ADDR=10.0.10.21
ALERTING_DB_STANDBY_ADDR=10.0.10.22

# Как до них дойти по SSH. Используется установщиком и — важно — учением
# переключения: на разнесённых базах `pg_ctl` надо выполнить на чужом хосте.
ALERTING_PROXY_SSH=root@10.0.10.10
ALERTING_APP1_SSH=root@10.0.10.11
ALERTING_APP2_SSH=root@10.0.10.12
ALERTING_DB_PRIMARY_SSH=root@10.0.10.21
ALERTING_DB_STANDBY_SSH=root@10.0.10.22

# --- подсети ------------------------------------------------------------------
# Откуда разрешён вход на узел приложения (порт 8080). Это подсеть прокси, а не
# пользовательская: пользователи до узлов не достают вообще.
ALERTING_PROXY_NET=10.0.10.0/24
# Откуда разрешён SSH.
ALERTING_ADMIN_NET=10.0.99.0/24
# Откуда приходят люди. Единственное место, где эта подсеть вообще упоминается, —
# firewall прокси: до узлов приложения пользователи не достают.
ALERTING_USER_NET=10.0.0.0/16
# Площадочный VLAN с контроллерами сирен. Односторонний выход, без обратного пути.
ALERTING_SIREN_NET=10.0.30.0/24
ALERTING_SIREN_PORT=10001
# Куда вывозятся опубликованные головы аудита — единственный артефакт, который по
# замыслу покидает машину.
ALERTING_AUDITOR_HOST=10.0.20.7
# Откуда разрешено снимать метрики. Один хост, а не подсеть: ответ `/v1/metricsz`
# — более полная картина системы, чем готовность.
ALERTING_SCRAPER_ADDR=10.0.20.9

# --- имена и версии -----------------------------------------------------------
ALERTING_FQDN=alerting.example.internal
ALERTING_ORG=acme
ALERTING_ORG_LABEL=ACME
ALERTING_PGVERSION=16

# --- что это за контур --------------------------------------------------------
# `staging` разрешает то, чего боевой контур не должен видеть: заглушки каналов
# (ALERTING_ALLOW_STUB_CHANNELS) и самоподписанный УЦ. Установщик читает это
# значение и отказывается ставить заглушки при `production` — см. §7 плана
# развёртывания и docs/09-deployment.md §0.
ALERTING_CONTOUR=staging

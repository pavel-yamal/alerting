# /etc/alerting/alerting.env — environment for the alerting server.
# Mode 0640, owned root:alerting. NO SECRETS HERE: keys arrive via systemd
# LoadCredential= as files, never as environment variables.
#
# Every path is ABSOLUTE on purpose. Relative values resolve against the working
# directory, and they fail *silently* when that is wrong: a missing wordlist used to
# disable wake codes, and misplaced heads and spool are simply not where the backup
# looks.

# --- identity ----------------------------------------------------------------
ALERTING_ORG=acme
ALERTING_ORG_LABEL=ACME
# Where people reach this node, e.g. https://alert.example.org: the RSS channel links
# to its own feed there. Empty: built from the request's Host.
ALERTING_PUBLIC_URL=

# The pinned org root PUBLIC key. Not a secret, but integrity-critical: substituting
# it lets a forged directory through the server's own check. Verify it out of band
# against the value the custodians hold.
# The server REFUSES TO START without it.
ALERTING_ROOT_PUBKEY=

# --- database ----------------------------------------------------------------
# The connection string is NOT here: it carries a password, so it arrives as a
# credential file like the keys do. This unit gets the APPLICATION role's DSN
# (alerting_app: SELECT and INSERT on audit_log, nothing else). The owner's DSN goes
# only to alerting-migrate.service. See deploy/env/credentials.README.md.
#
# ALERTING_DSN_FILE is NOT set here, and neither is ALERTING_SERVER_KEY_FILE. Both
# used to be, as `%d/dsn` and `%d/server-key` -- and `%d` is a systemd specifier,
# expanded in unit directives, not in the contents of a file named by
# EnvironmentFile=. The node would have received those two strings literally and
# found neither the DSN nor the audit-head signing key. Both now live in
# `Environment=` inside alerting.service, where `%d` does expand.

# --- push to the decision-makers' app (docs/14-approver-app.md, "Push") -----------
# iOS straight to APNs with the team's .p8 key, Android through FCM. Empty = off.
# Key files 0600, owned by the service user; a key that cannot be used stops the node.
ALERTING_APNS_TEAM_ID=
ALERTING_APNS_KEY_ID=
ALERTING_APNS_KEY_FILE=
ALERTING_APNS_TOPIC=me.yamal.alert
ALERTING_FCM_SERVICE_ACCOUNT_FILE=
ALERTING_FCM_PROJECT_ID=

# --- paths -------------------------------------------------------------------
# Which node this is, in the heartbeat table. The default is the hostname, which is
# right on a VM and wrong in a container: without it every replica overwrites one row
# and a channel that is reachable from one node but not another looks fine.
ALERTING_NODE_ID=

# How often each channel is asked whether it is still there.
ALERTING_HEARTBEAT_INTERVAL_S=60

# How often the leader sends a canary order to the synthetic recipient -- the check
# that answers "would an order go out right now", which readiness only approximates.
# An hour, because canary runs go into the audit chain and a minute would put
# millions of rows a year into a table that cannot be pruned. 0 disables it, which a
# production node should not do: nothing else tests the delivery path end to end.
ALERTING_CANARY_INTERVAL_S=3600

ALERTING_HEADS_DIR=/var/lib/alerting/heads
ALERTING_SPOOL_DIR=/var/lib/alerting/spool
ALERTING_WORDLIST=/opt/alerting/current/config/wordlist.ru.txt
ALERTING_ESCALATION_CONFIG=/etc/alerting/escalation.yaml

# --- secrets, as file paths --------------------------------------------------
# systemd LoadCredential= puts these under $CREDENTIALS_DIRECTORY at mode 0400 and
# the unit points at them; see the note under "database" above for why the paths are
# not in this file. The server refuses any secret file readable by group or others.
# No HTTP key: every request carries a per-person Ed25519 signature checked against
# the root-signed directory. Revoking one person is a directory publish, not a
# rotation everybody has to be told about.

# --- behaviour ---------------------------------------------------------------
ALERTING_ESCALATION_INTERVAL_S=5
ALERTING_LOG_LEVEL=INFO
ALERTING_LOG_JSON=0

# Sites where a DRILL may sound the siren. Set ONLY for the duration of an exercise
# and remove it afterwards — it is the single thing standing between a drill and a
# real evacuation.
ALERTING_DRILL_SITES=

# --- things a production node must NOT set -----------------------------------
# ALERTING_ALLOW_STUB_CHANNELS=1   # channels that report delivery without sending
# ALERTING_ENV=production          # only affects scripts/org_init.py, which must
#                                  # never run here: it writes the org ROOT PRIVATE
#                                  # KEY to local disk.

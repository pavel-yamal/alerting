# /etc/alerting/alerting.env — environment for the alerting server.
# Mode 0640, owned root:alerting. NO SECRETS HERE: keys arrive via systemd
# LoadCredential= as files, never as environment variables.
#
# Every path is ABSOLUTE on purpose. Relative values resolve against the working
# directory, and four of them fail *silently* when that is wrong: a wrong database
# path creates an empty database that still answers healthz, a missing wordlist
# used to disable wake codes, and misplaced heads and spool are simply not where
# the backup looks.

# --- identity ----------------------------------------------------------------
ALERTING_ORG=acme
ALERTING_ORG_LABEL=ACME

# The pinned org root PUBLIC key. Not a secret, but integrity-critical: substituting
# it lets a forged directory through the server's own check. Verify it out of band
# against the value the custodians hold.
# The server REFUSES TO START without it.
ALERTING_ROOT_PUBKEY=

# --- paths -------------------------------------------------------------------
ALERTING_DB=/var/lib/alerting/alerting.db
ALERTING_HEADS_DIR=/var/lib/alerting/heads
ALERTING_SPOOL_DIR=/var/lib/alerting/spool
ALERTING_WORDLIST=/opt/alerting/current/config/wordlist.ru.txt
ALERTING_ESCALATION_CONFIG=/etc/alerting/escalation.yaml

# --- secrets, as file paths --------------------------------------------------
# systemd LoadCredential= puts these under $CREDENTIALS_DIRECTORY at mode 0400.
# The server refuses any secret file readable by group or others.
ALERTING_SERVER_KEY_FILE=%d/server-key
ALERTING_API_KEY_FILE=%d/api-key

# --- behaviour ---------------------------------------------------------------
ALERTING_ESCALATION_INTERVAL_S=5
ALERTING_LOG_LEVEL=INFO
ALERTING_LOG_JSON=0

# Sites where a DRILL may sound the siren. Set ONLY for the duration of an exercise
# and remove it afterwards — it is the single thing standing between a drill and a
# real evacuation.
ALERTING_DRILL_SITES=

# --- things a production node must NOT set -----------------------------------
# ALERTING_ALLOW_STUB_CHANNELS=1   # channels that report delivery without sending
# ALERTING_ALLOW_UNAUTHENTICATED=1 # an open HTTP surface
# ALERTING_ENV=production          # only affects scripts/org_init.py, which must
#                                  # never run here: it writes the org ROOT PRIVATE
#                                  # KEY to local disk.

<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: neither to Google's cloud backup nor to a new phone by
     device-to-device transfer. The signing key is bound to this phone's Keystore and
     biometrics; a copy elsewhere is useless and a stale panel address is confusing.
     A new phone means a new key and a new enrolment (docs/adr/0016). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Push through APNs (docs/14-approver-app.md). "development" is for builds from
		Xcode; exporting for the App Store or TestFlight, Xcode signs the production
		value itself. The server keeps each token's environment (push_tokens.apns_env).
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>

# Скопируйте в docker/.env (он в .gitignore) и заполните.
# СЕКРЕТОВ ЗДЕСЬ НЕТ: пароли и DSN генерируются в томах сервисом secrets-init.

ALERTING_ORG=acme
ALERTING_ORG_LABEL=ACME

# Корневой ПУБЛИЧНЫЙ ключ организации. Не секрет, но подмена пропускает поддельный
# справочник: сверить вне канала с тем, что держат хранители. Без него сервер не
# стартует. Для демо его печатает org-init.
ALERTING_ROOT_PUBKEY=

# Имя узла в таблице heartbeat. В контейнере hostname случайный, поэтому задаётся явно
# и разное на каждом сервере.
ALERTING_NODE_ID=app-1

# Два процесса, как в боевом контуре: падение одного не прерывает работу. Приказ
# доходит до телефона, к какому бы процессу тот ни был подключён — процессы передают
# его друг другу через PostgreSQL (docs/12-docker.md §7).
ALERTING_WORKERS=2
ALERTING_BIND=127.0.0.1
ALERTING_PORT=7070
# Веб-панель дежурного и ЛПР.
ALERTING_PANEL_PORT=7071
# Адрес привязки панели, отдельно от API. Для обратного прокси на другой машине —
# адрес этого сервера в сети (например 192.168.100.14). Подпись ключом устройства
# работает только по https:// или на localhost, поэтому из сети — через прокси с TLS.
ALERTING_PANEL_BIND=127.0.0.1
# Демо-вход в панель ключами из тома clients (пароль demo). Ключ при этом
# расшифровывается на сервере: для реальной работы поставьте 0 и входите ключом
# устройства (docs/12-docker.md).
ALERTING_PANEL_DEMO_KEYS=1
# Страница исполнителя для телефона.
ALERTING_MOBILE_PORT=7072
# 127.0.0.1 — только с самого сервера. Чтобы открыть с телефона в той же сети,
# поставьте 0.0.0.0: страница пойдёт по HTTP без шифрования, а за ней ключи
# демо-исполнителей. Только для стенда и только на время показа.
ALERTING_MOBILE_BIND=127.0.0.1
# Адрес nginx, если он перед контейнером (на хосте это обычно шлюз docker-сети).
ALERTING_FORWARDED_ALLOW_IPS=

# Площадки, где УЧЕНИЕ может включить сирену. Только на время учения.
ALERTING_DRILL_SITES=

# push, SMS, голос и сирена пока заглушки; лестница эскалации по умолчанию их
# содержит, и без этого флага узел не стартует. Для демо — 1. На боевом узле — 0 и
# лестница только из настоящих каналов.
ALERTING_ALLOW_STUB_CHANNELS=1
